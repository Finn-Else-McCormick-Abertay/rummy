[node name="Game Configuration" type="ScrollContainer" parent="PanelContainer/Control/TabContainer"]
visible = false
layout_mode = 2
metadata/_tab_index = 1

[node name="Game Config Help" type="RichTextLabel" parent="PanelContainer/Control/TabContainer/Game Configuration"]
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
text = "
[font_size=24][b]Player Configuration[/b][/font_size]
Open the config menu with the gear icon in the top left corner.
In the config menu, drag players up and down in the list to change their order.
Press the gear icon to change the player's name and type, as well as any options that player type has.
Press the 'add player' button at the end of the list to add a new player. Press the 'X' on a player to delete them.

You can manually save and load player configurations with the buttons at the top of the config menu.
When the application is closed, your configuration will be automatically saved, and loaded the next time the application starts.

[font_size=24][b]Shortcuts[/b][/font_size]
You can open the config screen with [i]Escape[/i].

You can open the scoreboard with [i]S[/i].

You can open the help screen with [i]H[/i].

You can open the console with [i]Ctrl + Tab[/i].
At the bottom of the console there are toggles for different 'layers' - Game, Player and Thought.
 - 'Game' is game output re-which turn it is etc.
 - 'Player' is public player output.
 - 'Thought' is secret player output, displaying calculated utility values etc."
fit_content = true
script = ExtResource("4_416vn")
markdown_text = "
# Player Configuration
Open the config menu with the gear icon in the top left corner.
In the config menu, drag players up and down in the list to change their order.
Press the gear icon to change the player's name and type, as well as any options that player type has.
Press the 'add player' button at the end of the list to add a new player. Press the 'X' on a player to delete them.

You can manually save and load player configurations with the buttons at the top of the config menu.
When the application is closed, your configuration will be automatically saved, and loaded the next time the application starts.

# Shortcuts
You can open the config screen with *Escape*.

You can open the scoreboard with *S*.

You can open the help screen with *H*.

You can open the console with *Ctrl + Tab*.
At the bottom of the console there are toggles for different 'layers' - Game, Player and Thought.
 - 'Game' is game output re-which turn it is etc.
 - 'Player' is public player output.
 - 'Thought' is secret player output, displaying calculated utility values etc."
